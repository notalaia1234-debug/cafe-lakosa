
/* RESET DAN PENGATURAN DASAR */
* {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
  scroll-behavior: smooth;
}

body {
  font-family: Arial, sans-serif;
  background-color: #faf6ef;
  color: #38251d;
  line-height: 1.6;
}

/* HEADER DAN NAVIGASI */
header {
  background-color: #3b261e;
  color: white;
  padding: 18px 8%;
  display: flex;
  justify-content: space-between;
  align-items: center;
  flex-wrap: wrap;
  gap: 12px;
}

header h2 {
  color: #e9c99c;
}

nav a {
  color: white;
  text-decoration: none;
  margin-left: 15px;
  font-size: 14px;
}

nav a:hover {
  color: #e9c99c;
}

/* BERANDA */
.hero {
  min-height: 370px;
  padding: 80px 8%;
  text-align: center;
  background: linear-gradient(135deg, #ead9c3, #faf6ef);
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
}

.hero h1 {
  font-size: clamp(32px, 6vw, 52px);
  margin-bottom: 12px;
}

.hero p {
  max-width: 560px;
  margin-bottom: 25px;
}

/* TOMBOL */
.btn {
  display: inline-block;
  background-color: #70452e;
  color: white;
  padding: 12px 24px;
  border-radius: 25px;
  text-decoration: none;
  transition: 0.3s;
}

.btn:hover {
  background-color: #3b261e;
}

/* BAGIAN WEBSITE */
section {
  padding: 55px 8%;
  text-align: center;
}

section h2 {
  margin-bottom: 20px;
  font-size: 28px;
}

/* TENTANG KAMI */
.about p {
  max-width: 700px;
  margin: auto;
}

/* DAFTAR MENU */
.menu-list {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(190px, 1fr));
  gap: 20px;
  margin-top: 25px;
}

.menu-card {
  background-color: white;
  border-radius: 14px;
  padding: 25px 18px;
  box-shadow: 0 4px 14px #0000000d;
  transition: transform 0.3s;
}

.menu-card:hover {
  transform: translateY(-5px);
}

.menu-card .emoji {
  font-size: 42px;
}

.menu-card h3 {
  margin: 10px 0;
}

.price {
  color: #805235;
  font-weight: bold;
  margin-top: 8px;
}

/* KONTAK */
.contact {
  background-color: #ead9c3;
}

/* FOOTER */
footer {
  background-color: #3b261e;
  color: white;
  text-align: center;
  padding: 20px;
  font-size: 14px;
}

/* TAMPILAN HP */
@media (max-width: 600px) {
  header {
    justify-content: center;
  }

  nav {
    text-align: center;
  }

  nav a {
    display: inline-block;
    margin: 5px 7px;
  }
}
